# Copie os valores do seu projeto Supabase e configure em Vercel > Settings > Environment Variables
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# Crie uma senha forte exclusiva para o painel. Não compartilhe este arquivo.
ADMIN_USER=admin
ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI

# Segredo aleatório longo para assinar a sessão. Use pelo menos 32 caracteres.
TOKEN_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_LONGO_AQUI
